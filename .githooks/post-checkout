#!/usr/bin/env bash
# Branch checkout sync is offline; file checkouts must not deploy integrations.
set -euo pipefail
if [[ -x "$HOME/.config/git/run-global-hooks" ]]; then
    "$HOME/.config/git/run-global-hooks" post-checkout "$@"
fi
[[ "${3:-1}" == 0 ]] && exit 0
ROOT="$(git rev-parse --show-toplevel)"
[[ "${1:-}" =~ ^0+$ ]] && exit 0
exec "$ROOT/scripts/sync-submodule-to-custom-components.sh" --previous-revision "$1" --changed-only
