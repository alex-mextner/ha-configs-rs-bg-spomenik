#!/usr/bin/env bash
# system: hostname (+ its 127.0.1.1 line in /etc/hosts) and timezone from [modules.system].
source "$(dirname "$0")/../../lib/common.sh" "$@"

hostname=$(opt '.hostname')
timezone=$(opt '.timezone')

if [[ $hostname != null ]]; then
	if [[ $(cat /etc/hostname 2>/dev/null) != "$hostname" ]]; then
		drift "hostname -> $hostname" && hostnamectl set-hostname "$hostname"
	fi
	if ! grep -qE "^127\.0\.1\.1[[:space:]]+$hostname([[:space:]]|$)" /etc/hosts; then
		if drift "/etc/hosts: 127.0.1.1 $hostname"; then
			sed -i '/^127\.0\.1\.1[[:space:]]/d' /etc/hosts
			echo "127.0.1.1	$hostname" >>/etc/hosts
		fi
	fi
fi

if [[ $timezone != null ]]; then
	[[ -f /usr/share/zoneinfo/$timezone ]] || { echo "  unknown timezone $timezone" >&2; exit 2; }
	if [[ $(readlink /etc/localtime) != *"/zoneinfo/$timezone" ]]; then
		drift "timezone -> $timezone" && timedatectl set-timezone "$timezone"
	fi
fi

finish
