#!/usr/bin/env bash
# login-shell: [modules.login-shell.shells] maps a user (who must exist: the users module creates the declared ones)
# to a login shell, e.g. ultra = "/usr/bin/zsh". A shell is set only once it is usable (shell_usable: installed and in
# /etc/shells, or nologin/false), as sshd refuses a user whose shell is missing. Until then the user keeps the current
# shell and the module fails, naming the shell; so does a declared shell that is set but was removed since. A user
# that does not exist fails the module too, after every other entry has been handled.
source "$(dirname "$0")/../../lib/common.sh" "$@"

if [[ $(opt '(.shells // {}) | type == "object" and all(.[]; type == "string")') != true ]]; then
	echo "  login-shell: shells must be a table of user = \"/path/to/shell\"" >&2
	exit 2
fi
# read before the loop, not from a process substitution, whose failure would go unnoticed
entries=$(opt '.shells // {} | to_entries[] | "\(.key)\t\(.value)"')
unusable=() missing_users=()
while IFS=$'\t' read -r user shell; do
	[[ -n $user ]] || continue
	if ! entry=$(getent passwd "$user"); then
		# a preview runs before the users module has created the user
		drift "$user: login shell -> $shell once the user exists" && missing_users+=("$user")
		continue
	fi
	current=$(cut -d: -f7 <<<"$entry")
	if ! shell_usable "$shell"; then
		if [[ $current == "$shell" ]]; then
			drift "$user: login shell $shell is no longer installed (or not in /etc/shells): sshd refuses $user" || true
		else
			drift "$user: login shell $current -> $shell once $shell is installed (and in /etc/shells); keeping" \
				"$current" || true
		fi
		unusable+=("$shell")
		continue
	fi
	[[ $current != "$shell" ]] || continue
	drift "$user: login shell $current -> $shell" && usermod --shell "$shell" "$user"
done <<<"$entries"
if [[ $MODE == install ]] && ((${#missing_users[@]} + ${#unusable[@]})); then
	if ((${#missing_users[@]})); then
		echo "  login-shell: no such user: ${missing_users[*]} (declare it in the users module or create it first)" >&2
	fi
	if ((${#unusable[@]})); then
		echo "  login-shell: not installed or not in /etc/shells: ${unusable[*]} (its package, then re-run)" >&2
	fi
	exit 1
fi
finish
