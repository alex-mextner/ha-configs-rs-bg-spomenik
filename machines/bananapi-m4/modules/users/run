#!/usr/bin/env bash
# users: [[modules.users.users]] name, groups, sudo ("nopasswd" | "password" | "none"), linger, authorized_keys.
# authorized_keys is exclusive: the file holds exactly the declared keys. A user without a password is created with a
# locked password (key-only login), which is why such a user wants sudo = "nopasswd".
# Groups that do not exist yet are created as system groups; extra groups the user has are left alone.
# The login shell is the login-shell module's: a new user is created with the shell it declares there once that shell
# is usable (nologin for an account that must not log in), else with useradd's default until login-shell sets it.
source "$(dirname "$0")/../../lib/common.sh" "$@"

count=$(opt '.users // [] | length')
for ((i = 0; i < count; i++)); do
	u=$(opt ".users[$i]")
	name=$(jq -r '.name' <<<"$u")
	if [[ $(jq 'has("shell")' <<<"$u") == true ]]; then
		echo "  $name: shell is declared in [modules.login-shell.shells] now, not in [[modules.users.users]]" >&2
		exit 2
	fi
	sudo_rule=$(jq -r '.sudo // "none"' <<<"$u")
	linger=$(jq -r '.linger // false' <<<"$u")

	if ! getent passwd "$name" >/dev/null; then
		shell=$(jq -r --arg name "$name" '.modules["login-shell"].shells[$name] // ""' <<<"${DT_CONFIG:-{\}}")
		with_shell=()
		if shell_usable "$shell"; then with_shell=(--shell "$shell"); fi
		drift "create user $name${with_shell[*]:+ (${with_shell[1]})}" &&
			useradd --create-home --user-group "${with_shell[@]}" "$name"
	fi
	home=$(getent passwd "$name" | cut -d: -f6 || true)
	home=${home:-/home/$name}

	for group in $(jq -r '.groups // [] | .[]' <<<"$u"); do
		if ! getent group "$group" >/dev/null; then
			drift "create group $group" && groupadd --system "$group"
		fi
		if ! id -nG "$name" 2>/dev/null | tr ' ' '\n' | grep -qx "$group"; then
			drift "$name: add to group $group" && usermod -aG "$group" "$name"
		fi
	done

	rule=/etc/sudoers.d/90-debian-tweaks-$name
	case "$sudo_rule" in
	nopasswd | password)
		tag=$([[ $sudo_rule == nopasswd ]] && echo "NOPASSWD: " || true)
		tmp=$(mktemp)
		printf '%s\n%s ALL=(ALL:ALL) %sALL\n' "$MARKER" "$name" "$tag" >"$tmp"
		visudo -cqf "$tmp" >/dev/null || { echo "  $rule: visudo rejects the rule" >&2; rm -f "$tmp"; exit 1; }
		ensure_file "$rule" 440 root:root <"$tmp" || true
		rm -f "$tmp"
		;;
	none) absent "$rule" || true ;;
	*) echo "  $name: sudo must be nopasswd, password or none" >&2; exit 2 ;;
	esac

	if [[ $(jq -r '.authorized_keys // null' <<<"$u") != null ]]; then
		if [[ $MODE == install ]]; then install -d -m 700 -o "$name" -g "$name" "$home/.ssh"; fi
		# Process substitution, not a pipe: ensure_file must run in this shell so its DRIFT count survives.
		ensure_file "$home/.ssh/authorized_keys" 600 "$name:$name" < <(
			echo "$MARKER"
			jq -r '.authorized_keys[]' <<<"$u"
		) || true
	fi

	if [[ $linger == true && ! -e /var/lib/systemd/linger/$name ]]; then
		drift "$name: enable lingering (systemd --user runs without a login)" && loginctl enable-linger "$name"
	elif [[ $linger == false && -e /var/lib/systemd/linger/$name ]]; then
		drift "$name: disable lingering" && loginctl disable-linger "$name"
	fi
done
finish
