#!/usr/bin/env bash
# ssh-server: /etc/ssh/sshd_config.d/10-debian-tweaks.conf from [modules.ssh-server]
# (password_authentication, permit_root_login, allow_users). Turning passwords off, or naming allow_users, is refused
# while no user in [modules.users] (among allow_users, when set) declares an authorized key, has a login shell and can
# sudo (sudo = "nopasswd", or "password" with a password already set): that would lock the owner out.
# The drop-in is validated with `sshd -t` before ssh is reloaded (a reload keeps open sessions).
source "$(dirname "$0")/../../lib/common.sh" "$@"

password=$(opt '.password_authentication // false')
root_login=$(opt '.permit_root_login // "no"')
# Checked as JSON strings, before any shell word splitting: a newline in an entry would add an sshd directive. \A and
# \z, not ^ and $: Oniguruma's $ also matches before a final newline.
# first(.[]), not .[0] // empty: `//` drops a first bad entry that is `false`, letting the next one through.
bad=$(opt '[.allow_users // [] | .[] | select(type != "string" or (test("\\A[a-z_][a-z0-9_-]*\\z") | not))]
	| first(.[]) | tojson')
[[ -z $bad ]] || { echo "  allow_users: $bad is not a user name" >&2; exit 2; }
allow_users=$(opt '.allow_users // [] | join(" ")')
allow_line=${allow_users:+AllowUsers $allow_users}
yn() { [[ $1 == true ]] && echo yes || echo no; }

# A user counts as an admin only if they can log in with a key AND then use sudo: their shell is executable, in
# /etc/shells and not nologin/false (sshd refuses a missing shell; an empty field means /bin/sh), both today's and, if
# usable, the one [modules.login-shell.shells] declares (login-shell, at order 95, sets it later, or not at all under
# --only or after a Ctrl-C); sudo = "nopasswd", or sudo = "password" with a usable password already set on this
# machine (this spec never sets passwords). A user that does not exist counts only in a preview with the users module
# on, by the shell it would be created with; in install mode that module has already run.
has_login() {
	local entry current declared
	if ! entry=$(getent passwd "$1"); then
		[[ $MODE != install && $(cfg '.modules.users.enabled') != false ]] || return 1
		can_log_in "$(new_user_shell "$1" "$2")"
		return
	fi
	current=$(cut -d: -f7 <<<"$entry")
	can_log_in "${current:-/bin/sh}" || return 1
	declared=$(declared_shell "$1")
	[[ -z $declared ]] || ! shell_usable "$declared" || can_log_in "$declared"
}
can_sudo() {
	case "$2" in
	nopasswd) return 0 ;;
	password) [[ $(passwd -S "$1" 2>/dev/null | awk '{print $2}') == P ]] ;;
	*) return 1 ;;
	esac
}
if [[ $password == false || -n $allow_users ]]; then
	admins=0
	while read -r user rule; do
		[[ -z $allow_users || " $allow_users " == *" $user "* ]] || continue
		if has_login "$user" "$rule" && can_sudo "$user" "$rule"; then admins=$((admins + 1)); fi
	done < <(cfg '.modules.users.users // [] | .[] | select((.authorized_keys // []) | length > 0)
		| "\(.name) \(.sudo // "none")"')
	if ((admins == 0)); then
		echo "  refusing password_authentication = false / allow_users: no user in [modules.users] (among allow_users," \
			"when set) has authorized_keys, a login shell (installed, in /etc/shells) and working sudo (nopasswd, or" \
			"password with a password set)" >&2
		exit 1
	fi
fi

conf=/etc/ssh/sshd_config.d/10-debian-tweaks.conf
tmp=$(mktemp)
cat >"$tmp" <<EOF
$MARKER
PasswordAuthentication $(yn "$password")
KbdInteractiveAuthentication no
PermitRootLogin $root_login
PubkeyAuthentication yes
$allow_line
EOF
# Validate the candidate before it is written: an sshd that rejects its config does not start after the next
# reboot, which locks the owner out of this headless box. The candidate comes first, so its values win over the
# current drop-in that the main config includes.
if [[ $MODE == install ]]; then
	candidate=$(mktemp)
	{ cat "$tmp"; echo "Include /etc/ssh/sshd_config"; } >"$candidate"
	if ! sshd -t -f "$candidate"; then
		echo "  $conf: sshd -t rejects the new settings, file not written" >&2
		rm -f "$tmp" "$candidate"
		exit 1
	fi
	rm -f "$candidate"
fi
if ensure_file "$conf" 644 root:root <"$tmp" && [[ $MODE == install ]]; then
	sshd -t
	systemctl reload ssh
fi
rm -f "$tmp"
finish
