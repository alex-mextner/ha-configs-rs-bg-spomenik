[Unit]
Description=Home Assistant Docker Compose with Bluetooth host prerequisites
After=docker.service network-online.target dbus.service bluetooth.service
Requires=docker.service dbus.service
Wants=network-online.target bluetooth.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/ultra/homeassistant
ExecStartPre=+/home/ultra/homeassistant/scripts/ha_bluetooth_host.sh
ExecStart=/home/ultra/homeassistant/scripts/ha_compose.sh up -d
ExecReload=/home/ultra/homeassistant/scripts/ha_compose.sh up -d
ExecStop=/home/ultra/homeassistant/scripts/ha_compose.sh stop
User=ultra
TimeoutStartSec=300
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
