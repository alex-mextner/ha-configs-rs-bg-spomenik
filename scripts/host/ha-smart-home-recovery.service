[Unit]
Description=Detect smart-home failures and coordinate one repair agent
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 %h/.local/share/ha-smart-home-recovery/ha_smart_home_recovery.py run
Environment=PATH=%h/.local/bin:%h/.bun/bin:/usr/local/bin:/usr/bin:/bin
TimeoutStartSec=210
Nice=10
UMask=0077
MemoryMax=256M
