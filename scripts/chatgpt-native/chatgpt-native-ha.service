[Unit]
Description=Separate native ChatGPT GUI for HA administrators
After=graphical-session.target
StartLimitIntervalSec=0

[Service]
EnvironmentFile=-%h/.config/chatgpt-native-ha.env
ExecStart=%h/.local/share/chatgpt-native-ha/gui-session/start.sh
Restart=always
RestartSec=15
RuntimeDirectory=chatgpt-native-ha
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
MemoryMax=2G
MemorySwapMax=512M
CPUQuota=150%
UMask=0077

[Install]
WantedBy=default.target
